:root { color-scheme: light; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #edf4ef; color: #173526; }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; }
.app { width: min(100%, 620px); background: #fff; border: 1px solid #cfe0d4; border-radius: 18px; box-shadow: 0 16px 45px rgba(24, 70, 45, .12); padding: clamp(22px, 5vw, 42px); }
h1 { margin: 0; font-size: clamp(1.8rem, 5vw, 2.6rem); }
.intro { color: #536c5e; margin: 8px 0 28px; }
label { display: block; font-weight: 700; margin-bottom: 8px; }
.entry { display: flex; gap: 10px; }
input { flex: 1; min-width: 0; border: 2px solid #b9cebf; border-radius: 10px; padding: 12px 14px; font: inherit; }
input:focus { outline: 3px solid #a9dcc0; border-color: #207245; }
button { border: 0; border-radius: 10px; padding: 11px 16px; font: inherit; font-weight: 700; cursor: pointer; background: #207245; color: #fff; }
button:hover { background: #145c35; }
button:focus-visible { outline: 3px solid #efb64e; outline-offset: 2px; }
.summary { margin: 24px 0 12px; font-weight: 800; color: #185f39; }
.habit-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
.habit { display: flex; align-items: center; gap: 12px; border: 1px solid #d7e5da; border-radius: 12px; padding: 12px; }
.habit.done .habit-name { text-decoration: line-through; color: #718078; }
.habit-name { flex: 1; overflow-wrap: anywhere; }
.toggle { background: #e2f1e7; color: #155d35; }
.delete { background: #f7e3e0; color: #8d2d25; }
.empty { text-align: center; color: #718078; padding: 20px 0 4px; }
@media (max-width: 520px) { .entry { flex-direction: column; } .habit { align-items: stretch; flex-wrap: wrap; } .habit-name { flex-basis: 100%; } }
@media (prefers-reduced-motion: no-preference) { button { transition: background-color .15s ease, transform .15s ease; } button:active { transform: translateY(1px); } }
