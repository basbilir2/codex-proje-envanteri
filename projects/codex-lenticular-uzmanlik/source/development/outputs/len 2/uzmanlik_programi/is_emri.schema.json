{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra iş emri",
  "type": "object",
  "required": [
    "order_id",
    "issued_by",
    "objective",
    "workspace",
    "inputs",
    "allowed_operations",
    "allowed_write_paths",
    "parameters",
    "stop_conditions",
    "expected_evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_by": {
      "const": "Astra"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_metadata",
          "set_approved_parameters",
          "render",
          "animate",
          "prepare_print",
          "generate_pitch_test",
          "collect_logs",
          "run_specified_check"
        ]
      }
    },
    "allowed_write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
